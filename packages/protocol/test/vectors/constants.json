{
  "description": "Language-neutral protocol constants and enums for tokimeki v1/v1.1.",
  "protocolVersion": 1,
  "frameTypes": {
    "INPUT": 1,
    "OUTPUT": 2,
    "SNAPSHOT": 3,
    "RESYNC_REQ": 4,
    "SNAPSHOT_TO": 5,
    "TUNNEL": 6,
    "TUNNEL_TO": 7,
    "FRAGMENT": 8
  },
  "roles": ["host", "viewer", "observer", "agent", "listener"],
  "reservedRoles": [],
  "transportModes": ["p2p-direct", "p2p-turn", "relay"],
  "transportStates": ["selecting", "ready", "failed"],
  "iceProviders": ["coturn", "static", "cloudflare", "stun"],
  "iceTransportPolicies": ["all", "relay"],
  "resizePolicies": ["latest", "min", "pinned"],
  "signalKinds": ["offer", "answer", "ice"],
  "errorCodes": [
    "unauthorized",
    "invalid_message",
    "unsupported_version",
    "invalid_session",
    "invalid_client_id",
    "duplicate_client_id",
    "invalid_role",
    "invalid_frame",
    "unsupported_frame",
    "frame_too_large",
    "invalid_target",
    "not_implemented",
    "session_full",
    "host_offline",
    "host_exited",
    "slow_consumer",
    "transport_failed",
    "internal",
    "invalid_request",
    "not_found",
    "lease_expired",
    "lease_mismatch",
    "task_terminal",
    "task_canceled",
    "capacity_exceeded"
  ],
  "closeCodes": {
    "normal": 1000,
    "goingAway": 1001,
    "protocolError": 1002,
    "messageTooBig": 1009,
    "internalError": 1011,
    "slowConsumer": 4000,
    "unauthorized": 4001,
    "sessionFull": 4002,
    "invalidMessage": 4003,
    "hostExited": 4004,
    "notImplemented": 4005
  },
  "limits": {
    "maxFrameBytes": 1048576,
    "maxDatachannelMessageBytes": 16384,
    "fragmentHeaderBytes": 13,
    "maxFragmentCount": 65,
    "maxTerminalDimension": 10000,
    "maxSessionIdLength": 64,
    "maxClientIdLength": 64,
    "minTargetIdBytes": 1,
    "maxTargetIdBytes": 64,
    "tunnelRecordHeaderBytes": 28,
    "tunnelNonceBytes": 12,
    "tunnelTagBytes": 16,
    "tunnelKeyBytes": 32,
    "minTunnelSecretBytes": 16,
    "tunnelMaxFrameBytes": 16339,
    "tunnelOutputPayloadMaxBytes": 16330,
    "tunnelInputPayloadMaxBytes": 16338,
    "tunnelMaxRecordBytes": 16383
  },
  "patterns": {
    "sessionId": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "clientId": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "u64Decimal": "^(0|[1-9][0-9]*)$"
  },
  "tunnelRecordVersion": 1,
  "tunnelRecordTypes": {
    "data": 1,
    "ack": 2,
    "fec": 3,
    "ping": 4
  },
  "tunnelDirections": {
    "hostToViewer": 1,
    "viewerToHost": 2
  },
  "tunnelKeyModes": ["session-token", "shared-secret"],
  "tunnelArqMode": "selective-repeat",
  "tunnelCryptoMode": "aes-256-gcm"
}
