{
  "name": "@tokimeki/relay",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + Durable Object relay for tokimeki terminal sessions",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@limccn/tokimeki-protocol": "0.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limccn/tokimeki.git",
    "directory": "packages/relay"
  }
}
