{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokimeki-relay",
  "main": "packages/relay/src/index.ts",
  "compatibility_date": "2026-04-07",
  "observability": {
    "enabled": true
  },
  // Optional v1.7 per-IP limit for GET /ws/* upgrades. It is intentionally NOT
  // enabled in this open-source/Deploy Button config: Cloudflare plan support
  // varies, and the Worker fails open (with a logged error) when the binding is
  // absent. To enable it, uncomment and pick your own unique namespace_id:
  // "ratelimits": [
  //   {
  //     "name": "TOKIMEKI_WS_IP_LIMIT",
  //     "namespace_id": "3001",
  //     "simple": { "limit": 30, "period": 60 }
  //   }
  // ],
  // Static no-JWT onboarding page (packages/onboarding-site). Existing files
  // are served from assets; non-asset paths (/ws/*, /healthz, /auth/*) fall
  // through to the Worker. No SPA fallback, so assets never swallow relay APIs.
  "assets": {
    "directory": "packages/onboarding-site/dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    // Open-source defaults. Add TURN credentials/secrets in the Cloudflare
    // dashboard or with `wrangler secret put`; see docs/deploy-cloudflare.md.
    "TOKIMEKI_TURN_PROVIDER": "auto",
    "TOKIMEKI_STUN_URLS": "stun:stun.cloudflare.com:3478"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDurableObject"]
    }
  ]
  // Optional Host JWT verification (all unset = JWT mode disabled):
  //   TOKIMEKI_JWT_JWKS_URL lives on the TokiAPI dashboard origin, e.g.
  //   https://tokiapi.app/api/tokimeki/jwks.json (https only).
  //   TOKIMEKI_JWT_ISSUER is required with the URL; TOKIMEKI_JWT_AUDIENCE
  //   defaults to "tokimeki-relay"; see docs/deploy-cloudflare.md.
}
