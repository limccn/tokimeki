{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.wrangler",
      "!**/scripts/perf/results",
      "!**/.trellis",
      "!**/.claude",
      "!**/.cursor",
      "!**/.codebuddy",
      "!**/.opencode",
      "!**/.pi",
      "!**/package-lock.json",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
