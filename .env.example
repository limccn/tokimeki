# tokimeki environment template
#
# Copy to .env (local only, never commit) or export these values in your shell.
# Production Worker secrets must be set with `wrangler secret put` instead of vars.
# Variables marked reserved are recognized but do not change v1 behavior.
# CLI guide: docs/cli.md. Relay/TURN deploy: docs/deploy-cloudflare.md.

# ── Relay Worker (secrets / vars) ─────────────────────────────────────────────
# Single-owner fallback credential. Required only for fallback mode (one person
# exclusively owning a relay); unset/blank rejects all fallback hosts.
# As soon as TOKIMEKI_NAMESPACE_TOKENS has at least one valid entry, this token
# and root "*" takeover stop working — migrate hosts to TOKIMEKI_TOKEN instead.
# Set as a Worker secret in production, never commit a real value.
TOKIMEKI_MASTER_TOKEN=change-me
# Optional static namespace host tokens (Worker secret; JSON object).
# Each key is a namespace (^[a-z0-9][a-z0-9_-]{0,31}$) and each value must be a
# unique random token >= 32 bytes, not equal to TOKIMEKI_MASTER_TOKEN.
# A namespace host may only use sessions named "<namespace>.<slug>".
# Invalid/duplicate entries fail closed (namespace auth disabled; fallback
# token stays usable). Enabling this map disables TOKIMEKI_MASTER_TOKEN.
# Example:
# TOKIMEKI_NAMESPACE_TOKENS={"team-a":"<32+ byte random>","team-b":"<32+ byte random>"}
TOKIMEKI_NAMESPACE_TOKENS=
# ── Host JWT (TokiAPI; all optional; unset JWKS URL = JWT mode disabled) ──────
# Public JWKS endpoint. It lives on the TokiAPI dashboard origin (the
# BETTER_AUTH_URL origin), e.g. https://tokiapi.app/api/tokimeki/jwks.json.
# Must be https:// with no userinfo or fragment.
TOKIMEKI_JWT_JWKS_URL=
# Required when the JWKS URL is set; compared exactly against the `iss` claim.
TOKIMEKI_JWT_ISSUER=
# Expected `aud` claim; defaults to "tokimeki-relay".
TOKIMEKI_JWT_AUDIENCE=tokimeki-relay
# JWKS cache lifetime in seconds (default 3600, clamped 60..86400).
TOKIMEKI_JWT_JWKS_TTL_SECONDS=3600
# Allowed clock skew for iat/nbf/exp in seconds (default 60, clamped 0..300).
TOKIMEKI_JWT_CLOCK_SKEW_SECONDS=60
# Session TTL after the host goes offline, in seconds.
TOKIMEKI_SESSION_TTL_SECONDS=86400
# Absolute session lifetime from creation, in seconds (default 86400). The host
# being online does not extend it; 0 disables the cap. Expiry closes sockets
# with error{host_exited} + close 4004 and deletes the session.
TOKIMEKI_SESSION_MAX_TTL_SECONDS=86400
# Inactivity lifetime from the last control/data frame or heartbeat, in
# seconds (default 0 = disabled). Expiry uses the same host_exited/4004 path.
TOKIMEKI_SESSION_IDLE_TTL_SECONDS=0
# Hard cap on relay-delivered terminal bytes per session (host OUTPUT/
# SNAPSHOT_TO and viewer INPUT, counted once per frame; default 0 = disabled).
# The counter is flushed every 1 MiB, so hibernation can lose up to 1 MiB:
# treat it as an approximate hard cap. P2P/TUN bytes never pass the relay.
TOKIMEKI_SESSION_MAX_BYTES=0
# Hard cap on inbound WebSocket messages per second for an active session
# (default 0 = disabled). Protects against short bursts; the window is reset
# when the Durable Object is evicted. Breach closes with session_full/4002.
TOKIMEKI_SESSION_MAX_MESSAGES_PER_SECOND=0
# Maximum concurrent clients per session (host + viewers).
TOKIMEKI_MAX_CLIENTS_PER_SESSION=8
# Additional cap for read-only listeners (also counted in the total above).
TOKIMEKI_MAX_LISTENERS=8

# ── ICE / TURN (relay -> client via welcome / ice) ────────────────────────────
TOKIMEKI_STUN_URLS=stun:stun.cloudflare.com:3478
# TURN provider: auto | coturn | cloudflare | none.
# auto = coturn REST, else static TURN (coturn static mode), else Cloudflare
# Realtime TURN, else STUN-only; Worker relay remains the final fallback.
TOKIMEKI_TURN_PROVIDER=auto

# Preferred: self-hosted coturn with TURN REST ephemeral credentials.
# Two accepted forms for the URL list:
#   - .dev.vars / shell: comma-separated string (shown below)
#   - wrangler.jsonc vars (recommended): JSON array, e.g.
#     ["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"]
# Every entry shares TOKIMEKI_COTURN_SECRET; there is no per-server secret.
# Put a turns:...?transport=tcp entry early for restrictive networks, but keep
# at least one turn:...?transport=udp entry for the CLI (libjuice needs UDP).
# The secret must match coturn's static-auth-secret on every server; set it as a
# Worker secret.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TOKIMEKI_COTURN_URLS=
TOKIMEKI_COTURN_SECRET=
# coturn credential TTL in seconds. Default 900 (15 min); 600..3600 recommended.
# TURN bytes cannot be metered by the relay, so keep credentials short-lived.
TOKIMEKI_COTURN_TTL_SECONDS=900

# Static TURN (coturn static mode or another self-hosted TURN); preferred over
# Cloudflare but below coturn REST.
TOKIMEKI_TURN_URLS=
TOKIMEKI_TURN_USERNAME=
TOKIMEKI_TURN_CREDENTIAL=

# Cloudflare Realtime TURN short-lived credential fallback (Worker secrets only).
TOKIMEKI_TURN_KEY_ID=
TOKIMEKI_TURN_API_TOKEN=
# Cloudflare TURN credential TTL in seconds. Default 900 (15 min);
# Cloudflare caps this at 172800 (48h).
TOKIMEKI_TURN_TTL_SECONDS=900

# ── Logging ───────────────────────────────────────────────────────────────────
TOKIMEKI_LOG_LEVEL=info

# ── Host CLI ──────────────────────────────────────────────────────────────────
# Relay endpoint (wss:// or https://). Required for host and attach.
# Deploy your own relay (docs/deploy-cloudflare.md) and replace this placeholder.
TOKIMEKI_RELAY_URL=wss://relay.example.com
# Session name. Defaults to <namespace>.<sanitized hostname-cwd> when
# TOKIMEKI_NAMESPACE is set; an explicit value must start with "<namespace>.".
TOKIMEKI_SESSION=
# Opaque host credential: a TokiAPI Host JWT or a static namespace token.
# The CLI never parses it. Requires TOKIMEKI_NAMESPACE; takes precedence over
# TOKIMEKI_MASTER_TOKEN (the single-owner fallback credential).
TOKIMEKI_TOKEN=
# Namespace name required with TOKIMEKI_TOKEN (^[a-z0-9][a-z0-9_-]{0,31}$).
TOKIMEKI_NAMESPACE=
# Session token. Generated by the host when empty; required for attach.
# Viewers may receive a TokiAPI Session JWT here; the CLI treats it as opaque
# and never parses it.
TOKIMEKI_SESSION_TOKEN=
# Optional per-session passcode (v1.2-D). 6..128 chars. The host sends only a
# PBKDF2 verifier to the relay; viewers submit the plaintext via
# X-Tokimeki-Passcode. This is NOT the 6-digit TokiAPI session access code.
TOKIMEKI_PASSCODE=
# PTY terminal capabilities.
TOKIMEKI_TERM=xterm-256color
TOKIMEKI_COLORTERM=truecolor
# Resize policy: latest | min | pinned. Ignored when the fixed TUI window is active.
TOKIMEKI_RESIZE_POLICY=latest
# <cols>x<rows>, used when TOKIMEKI_RESIZE_POLICY=pinned; also overrides
# TOKIMEKI_WINDOW_SIZE when set.
TOKIMEKI_PTY_SIZE=
# Fixed TUI window: tui | on | off. tui uses the command list below; on enables
# every host command; off restores legacy raw/resize behavior.
TOKIMEKI_WINDOW=tui
# Comma-separated executable basenames that use the fixed TUI window. This list
# is also the dynamic subcommand allow-list. Default (unset) covers the nine ACP
# commands: claude,pi,codex,gemini,cursor,aider,opencode,goose,amp. An explicit
# list replaces the default, so `tokimeki omp` works after:
#   TOKIMEKI_WINDOW_TUI=claude,pi,omp
TOKIMEKI_WINDOW_TUI=
# Fixed logical window size (<cols>x<rows>), default 120x40.
TOKIMEKI_WINDOW_SIZE=120x40
# Debug log-ring/view capacity (v1.4): corner area on wide terminals (>=120
# cols) and F11 full-screen view on narrow terminals. Default 200, max 2000;
# 0 disables the corner area and the F11 view.
TOKIMEKI_LOG_VIEW_ROWS=200
# Deprecated (v1.4): parsed only as a fallback capacity when
# TOKIMEKI_LOG_VIEW_ROWS is unset; no longer reserves a bottom panel.
# TOKIMEKI_LOG_PANEL_ROWS=8
# Local connection-menu key (v1.4): f12 | ctrl-] | off. F11 toggles the log view
# even when the menu is off.
TOKIMEKI_INVITE_KEY=f12
# CLI interaction mode: interactive | daemon. Top-level --interactive/--daemon
# override it; non-TTY defaults to daemon (no prompts; events on stderr).
TOKIMEKI_MODE=
# Envelope file layer for host commands (same as --config). Host-only:
# claude|pi|run|<acp>. The file must be regular, non-symlink, <=64 KiB, and 0600
# on POSIX when it contains credentials.
TOKIMEKI_CONFIG_FILE=
# TokiAPI share URL for `tokimeki attach` (viewer/listener). Use "-" to read one
# line from stdin. The URL is a capability secret; prefer env/stdin over argv.
TOKIMEKI_ATTACH_URL=
# TokiAPI provider base override (test/staging only; https or loopback http).
# Leave unset for https://tokiapi.app.
TOKIMEKI_TOKIAPI_URL=
# Optional JSON config envelope. Fields map to TOKIMEKI_* variables; explicit
# env vars win, then --config/TOKIMEKI_CONFIG_FILE, then this string, then
# ~/.tokimeki/config.json. The onboarding wizard may write config.json only
# after an explicit save (0600/atomic/no-follow); history is separate in
# ~/.tokimeki/history.json. JSON only.
# Example:
# TOKIMEKI_CONFIG={"v":1,"relayUrl":"wss://relay.example.com","session":"demo","sessionToken":"...","window":{"cols":120,"rows":40}}
TOKIMEKI_CONFIG=
# WebSocket heartbeat interval in seconds; 0 disables it.
TOKIMEKI_HEARTBEAT_SECONDS=25
# Headless terminal scrollback and snapshot limits.
TOKIMEKI_SCROLLBACK_LINES=1000
TOKIMEKI_SNAPSHOT_MAX_BYTES=262144
# Full ANSI snapshot interval for read-only listeners (250..60000 ms).
TOKIMEKI_LISTENER_SNAPSHOT_MS=1000
# TUI compatibility switches.
TOKIMEKI_PI_TUI_MODE=fullscreen
TOKIMEKI_CLAUDE_BG=0
# Transport selection for host and attach: auto | off (off forces the Worker relay).
# auto negotiates WebRTC per viewer; on failure it falls back to relay.
TOKIMEKI_P2P=auto
# ICE transport policy: all | relay.
# relay restricts candidates to TURN; with no usable TURN the P2P attempt times
# out (~12s) and falls back to relay. Clients never need coturn secrets.
TOKIMEKI_ICE_TRANSPORT_POLICY=all
# v1.7 (host only, default off): return a ready P2P viewer to the relay when
# its send buffer is at least 64 KiB and drains slower than this many bytes per
# second over a 3 s window. Idle links (below 64 KiB) never fall back. Unset/0
# disables; no ISP-specific default threshold is shipped.
TOKIMEKI_P2P_DRAIN_BYTES_PER_SEC=
# v1.7 (host only, default off): pace snapshots and OUTPUT frames above 1024
# payload bytes at this many bytes per second. Smaller OUTPUT is queued first;
# each snapshot starts within 8 s; the pacer queue pauses the shared PTY above
# 1 MiB and resumes at 256 KiB. Unset/0 keeps immediate writes.
TOKIMEKI_SEND_PACE_BYTES_PER_SEC=

# ── v1.1 TUN profile (P2P-only, opt-in) ──────────────────────────────────────
# off | auto. auto runs an AEAD + selective-repeat ARQ tunnel over an
# unreliable/unordered DataChannel when both peers advertise the same dialect.
# Relay data paths keep the v1 OUTPUT/INPUT/SNAPSHOT_TO frames and ACK flow
# control; the relay still answers TUNNEL/TUNNEL_TO with not_implemented.
TOKIMEKI_TUNNEL=off
# off | xor. xor emits one AEAD parity record per full group of eight data
# records; the receiver can rebuild exactly one lost record. Lost parity or
# multiple losses stay on the ARQ path. The capability advertises
# fec: ["none", "xor"]; peers without xor negotiate "none" and keep F1 behavior.
TOKIMEKI_TUNNEL_FEC=off
# Optional shared secret (>=16 bytes). When set, keyMode becomes shared-secret:
# the relay cannot derive the tunnel keys, so this mode is relay-blind as long
# as the secret is shared out of band and not leaked. Without it, keys are
# derived from the session token and the relay can derive them too.
TOKIMEKI_TUNNEL_SECRET=

# ── Attach CLI ────────────────────────────────────────────────────────────────
# Attach reuses TOKIMEKI_RELAY_URL, TOKIMEKI_SESSION, TOKIMEKI_SESSION_TOKEN,
# TOKIMEKI_HEARTBEAT_SECONDS, TOKIMEKI_P2P, TOKIMEKI_ICE_TRANSPORT_POLICY,
# TOKIMEKI_TUNNEL*, and TOKIMEKI_LOG_LEVEL.

# ── Live e2e (read by scripts/e2e/live-e2e.mjs, not by the CLI) ───────────────
# REQUIRE_P2P=1            fail unless the P2P data path is exercised
# E2E_P2P_MODE=auto        set "off" for the relay-only run
# E2E_ICE_POLICY=all       set "relay" to force TURN-only candidates
# REQUIRE_P2P_FALLBACK=1   fail unless a P2P attempt falls back to relay
# E2E_TUNNEL=1             require the P2P TUN profile (needs E2E_P2P_MODE=auto)
# E2E_TUNNEL_SECRET=...    optional shared secret for relay-blind tunnel keys
# E2E_TUNNEL_FEC=xor       require XOR FEC negotiation (needs E2E_TUNNEL=1;
#                          no packet loss is injected, recovery stays unit-tested)
# E2E_TIMEOUT_MS=45000

# ── v1.1 reserved (recognized but not implemented in this release) ───────────
# Fixed conservative ARQ window/MTU overrides remain reserved.
TOKIMEKI_TUNNEL_WINDOW=256
TOKIMEKI_TUNNEL_MTU=1200
# Read-only listener mode is available as `tokimeki attach --listen`.
# TOKIMEKI_VIEW_MODE remains a reserved v1.1 placeholder.
TOKIMEKI_VIEW_MODE=control
# LAN / route selection.
TOKIMEKI_ROUTE_POLICY=auto
TOKIMEKI_LAN_DISCOVERY=off
TOKIMEKI_LAN_FANOUT=off
