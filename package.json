{
  "name": "tokimeki-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker relay + P2P terminal sharing for TUI programs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "typecheck:relay": "tsc -b packages/relay/tsconfig.json --pretty false && tsc -p packages/relay/tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:relay": "vitest run --config packages/relay/vitest.config.ts",
    "test:all": "vitest run && vitest run --config packages/relay/vitest.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:relay": "npm run build && wrangler dev --config packages/relay/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "perf:smoke": "node scripts/perf/cli.mjs --scenario smoke",
    "perf:local": "node scripts/perf/cli.mjs --scenario local",
    "perf:matrix": "node scripts/perf/cli.mjs --scenario matrix",
    "perf:latency": "node scripts/perf/cli.mjs --scenario latency",
    "perf:flow": "node scripts/perf/cli.mjs --scenario flow",
    "perf:snapshot": "node scripts/perf/cli.mjs --scenario snapshot",
    "perf:soak": "node scripts/perf/cli.mjs --scenario soak",
    "perf:p2p": "node scripts/perf/cli.mjs --scenario p2p",
    "perf:cross-nat": "node scripts/perf/cli.mjs --scenario cross-nat",
    "perf:compare": "node scripts/perf/cli.mjs --compare",
    "deploy:prod": "npm run build && wrangler deploy --config packages/relay/wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/vitest-pool-workers": "0.12.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.106.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limccn/tokimeki.git"
  },
  "homepage": "https://github.com/limccn/tokimeki#readme",
  "bugs": {
    "url": "https://github.com/limccn/tokimeki/issues"
  }
}
